# ============================================================================
# Deskbolic Core — Rails Credentials Structure
# ============================================================================
# This file documents the expected structure of config/credentials.yml.enc.
#
# To edit credentials:
#   EDITOR=nano bin/rails credentials:edit
#
# CONVENTION:
#   - Rails credentials → secrets (passwords, API keys, tokens, signing keys)
#   - ENV variables → infrastructure config (URLs, ports, hostnames)
#   See .env.sample for the ENV variable documentation.
# ============================================================================

# Used as the base secret for all MessageVerifiers in Rails, including the one protecting cookies.
secret_key_base: GENERATE_WITH_RAILS_SECRET

# ─── Domain & Hosting ────────────────────────────────────────────────────────
domain: deskbolic.com
host: https://deskbolic.com
protocol: https

# ─── Database (production/staging only; dev/test uses ENV from .env) ─────────
db_username: PLACEHOLDER
db_password: PLACEHOLDER

# ─── SMTP / Email ────────────────────────────────────────────────────────────
smtp_username: "no-reply@deskbolic.com"
smtp_password: PLACEHOLDER
emails_from_address: no-reply@deskbolic.com
contact_email: info@deskbolic.com

# ─── Admin Panel ─────────────────────────────────────────────────────────────
admin_password: PLACEHOLDER

# ─── Channels ────────────────────────────────────────────────────────────────
channels:
  facebook:
    app_id: "2098895393814444"
    app_secret: PLACEHOLDER
    verify_token: PLACEHOLDER        # Random string for webhook verification
  instagram:
    app_id: "1922553766455728"       # Instagram App ID (from API setup with Instagram login)
    app_secret: PLACEHOLDER
    verify_token: PLACEHOLDER

# ─── Payment Gateway ─────────────────────────────────────────────────────────
payment:
  default_provider: paddle
paddle:
  product_id: PLACEHOLDER
  api_key: PLACEHOLDER
  webhook_secret: PLACEHOLDER

# ─── App URLs ────────────────────────────────────────────────────────────────
app:
  base_url: https://app.deskbolic.com

# ─── Per-Environment Overrides ───────────────────────────────────────────────
development:
  host: http://localhost:3000
  domain: localhost
  actioncable:
    host: "ws://localhost:3334"
  aws:
    bucket: deskbolic-development
    access_key_id: PLACEHOLDER
    secret_access_key: PLACEHOLDER
  channels:
    whatsapp:
      api_endpoint: https://graph.facebook.com
    facebook:
      app_id: "2098895393814444"
      app_secret: PLACEHOLDER
      verify_token: PLACEHOLDER
    instagram:
      app_id: "1922553766455728"
      app_secret: PLACEHOLDER
      verify_token: PLACEHOLDER
  wise:
    api_endpoint: https://api.sandbox.transferwise.tech
    api_key: PLACEHOLDER
    profile_id: PLACEHOLDER
    private_key: |
      -----BEGIN RSA PRIVATE KEY-----
      PLACEHOLDER
      -----END RSA PRIVATE KEY-----

production:
  host: https://deskbolic.com
  domain: deskbolic.com
  actioncable:
    host: "wss://deskbolic.com:3334"
  aws:
    bucket: deskbolic
    access_key_id: PLACEHOLDER
    secret_access_key: PLACEHOLDER
  channels:
    whatsapp:
      api_endpoint: https://graph.facebook.com
    facebook:
      app_id: "YOUR_PRODUCTION_APP_ID"
      app_secret: PLACEHOLDER
      verify_token: PLACEHOLDER
    instagram:
      app_id: "YOUR_PRODUCTION_INSTAGRAM_APP_ID"
      app_secret: PLACEHOLDER
      verify_token: PLACEHOLDER
  wise:
    api_endpoint: https://api.transferwise.com
    api_key: PLACEHOLDER
    profile_id: PLACEHOLDER
    private_key: |
      -----BEGIN RSA PRIVATE KEY-----
      PLACEHOLDER
      -----END RSA PRIVATE KEY-----

staging:
  host: https://staging.deskbolic.com
  domain: staging.deskbolic.com
  http_basic_authentication_password: PLACEHOLDER
  actioncable:
    host: "wss://staging.deskbolic.com:3334"
  aws:
    bucket: deskbolic-staging
    access_key_id: PLACEHOLDER
    secret_access_key: PLACEHOLDER
  channels:
    whatsapp:
      api_endpoint: https://graph.facebook.com
    facebook:
      app_id: "2098895393814444"
      app_secret: PLACEHOLDER
      verify_token: PLACEHOLDER
    instagram:
      app_id: "1922553766455728"
      app_secret: PLACEHOLDER
      verify_token: PLACEHOLDER
  wise:
    api_endpoint: https://api.sandbox.transferwise.tech
    api_key: PLACEHOLDER
    profile_id: PLACEHOLDER
    private_key: |
      -----BEGIN RSA PRIVATE KEY-----
      PLACEHOLDER
      -----END RSA PRIVATE KEY-----
# Run `bin/rails db:encryption:init` to generate these keys.
# Do not use production keys during development.
active_record_encryption:
  primary_key: <run db:encryption:init>
  deterministic_key: <run db:encryption:init>
  key_derivation_salt: <run db:encryption:init>

<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-style>
      .footer-link { color: #6b7280; text-decoration: underline; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9fafb">
    <mj-section padding-bottom="0px" padding-top="30px">
      <mj-column width="100%">
        <mj-image src="{{account.logo_url}}" alt="Logo" align="center" width="150px" padding-bottom="20px" />
      </mj-column>
    </mj-section>

    <mj-wrapper padding-top="0" padding-bottom="0">
      [[CONTENT_FOR_LAYOUT]]
    </mj-wrapper>

    <mj-section padding-top="30px">
      <mj-column width="100%">
        <mj-text align="center" color="#6b7280" font-size="12px" line-height="18px">
          &copy; {{account.name}}<br/>
          <a href="#" class="footer-link">Unsubscribe</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

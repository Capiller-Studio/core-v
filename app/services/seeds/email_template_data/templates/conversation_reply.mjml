<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text color="#1f2937" font-size="16px" line-height="24px">
          {{greeting}}
        </mj-text>
        <mj-text color="#4b5563" font-size="16px" line-height="24px" padding-top="15px">
          {{message.content}}
        </mj-text>
        <mj-text color="#4b5563" font-size="16px" line-height="24px" padding-top="20px">
          {{sign_off}}<br/>
          <strong>{{agent.name}}</strong>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

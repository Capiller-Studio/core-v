<mjml>
  <mj-body>
    <mj-section background-color="#ffffff" border-radius="8px" padding="32px 24px" box-shadow="0 4px 6px -1px rgba(0, 0, 0, 0.1)">
      <mj-column>
        <mj-text color="#111827" font-size="20px" font-weight="600" padding-bottom="16px" font-family="Inter, -apple-system, sans-serif">
          Hi {{customer.name}},
        </mj-text>
        
        <mj-text color="#374151" font-size="16px" line-height="26px" padding-bottom="24px" font-family="Inter, -apple-system, sans-serif">
          {{message.content}}
        </mj-text>
        
        <mj-divider border-color="#E5E7EB" border-width="1px" padding="12px 0 24px 0" />
        
        <mj-text color="#6B7280" font-size="14px" line-height="22px" font-family="Inter, -apple-system, sans-serif">
          Best regards,<br/>
          <strong style="color: #111827;">{{agent.name}}</strong><br/>
          {{account.name}} Support
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

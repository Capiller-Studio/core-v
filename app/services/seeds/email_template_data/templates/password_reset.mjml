<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text color="#1f2937" font-size="16px" line-height="24px">
          {{greeting}}
        </mj-text>
        <mj-text color="#4b5563" font-size="16px" line-height="24px" padding-top="15px">
          {{body_text}}
        </mj-text>
        <mj-button background-color="#2563eb" color="#ffffff" font-weight="600" border-radius="6px" href="{{reset_link}}" padding-top="20px">
          {{button_text}}
        </mj-button>
        <mj-text color="#9ca3af" font-size="13px" line-height="20px" padding-top="20px">
          {{expiry_notice}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-title>Your Affiliate Payout Statement</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="#334155" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F8FAFC">
    <mj-section background-color="#111827" padding="30px 40px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="800" color="#FFFFFF" letter-spacing="-0.025em">
          DESKBOLIC
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="40px" border-radius="0 0 12px 12px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" color="#111827" padding-bottom="12px">
          Affiliate Payout Processed
        </mj-text>
        <mj-text padding-bottom="16px">
          Hi [[ERB= @user&.display_name.presence || @user&.name.presence || "Partner" ]],
        </mj-text>
        <mj-text padding-bottom="20px">
          Great news! Your affiliate payout has been successfully processed and disbursed.
        </mj-text>

        <mj-text font-size="14px" color="#475569" padding-bottom="8px">
          <strong>Statement Code:</strong> [[ERB= @payout.code ]]
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding-bottom="8px">
          <strong>Disbursed Amount:</strong> [[ERB= @payout.currency ]] [[ERB= format('%.2f', @payout.amount) ]]
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding-bottom="20px">
          <strong>Date:</strong> [[ERB= @payout.created_at&.strftime('%B %d, %Y') || Time.current.strftime('%B %d, %Y') ]]
        </mj-text>

        <mj-text font-size="14px" color="#64748B" padding-top="12px">
          Your itemized statement invoice PDF is attached to this email for your financial and accounting records.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 40px">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#94A3B8">
          © [[ERB= Time.current.year ]] Capiller Rely Inc. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

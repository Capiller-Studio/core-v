<mjml>
  <mj-head>
    <mj-title><%= t("mailers.account_invitation.invite.subject", account_name: @account.name) %></mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="16px" color="#4b5563" line-height="1.6" />
      <mj-button background-color="#2563eb" color="#ffffff" font-size="16px" font-weight="700" border-radius="8px" padding="16px 32px" />
    </mj-attributes>
    <mj-style>
      .role-tag {
        display: inline-block;
        background-color: #f3f4f6;
        color: #374151;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 14px;
        font-weight: 600;
        margin-right: 8px;
        margin-bottom: 8px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9fafb">
    <mj-section background-color="#111827" padding="40px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="800" color="#ffffff" letter-spacing="-0.025em">
          DESKBOLIC
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="40px">
      <mj-column>
        <mj-text font-size="24px" font-weight="700" color="#111827" padding-bottom="16px">
          <%= t("mailers.account_invitation.invite.header") %>
        </mj-text>
        <mj-text>
          <%= t("mailers.account_invitation.invite.body_main", inviter_name: @inviter.display_name, account_name: @account.name).html_safe %>
        </mj-text>
        
        <mj-text font-weight="700" padding-bottom="8px">
          <%= t("mailers.account_invitation.invite.roles_label") %>
        </mj-text>
        <mj-text>
          <% @role_names.each do |role_name| %>
            <span class="role-tag"><%= role_name %></span>
          <% end %>
        </mj-text>

        <mj-text>
          <%= t("mailers.account_invitation.invite.body_footer") %>
        </mj-text>

        <mj-button href="<%= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') %>/invite/<%= @invitation.token %>">
          <%= t("mailers.account_invitation.invite.cta") %>
        </mj-button>

        <mj-text font-size="14px" color="#6b7280">
          <%= t("mailers.account_invitation.invite.expiry", expiry_date: @invitation.expires_at.strftime("%B %d, %Y")) %>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 40px">
      <mj-column>
        <mj-text align="center" font-size="14px" color="#9ca3af">
          <%= t("mailers.account_invitation.invite.footer", year: Time.current.year) %>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
